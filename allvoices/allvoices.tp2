LANGUAGE ~English~ ~english~ ~allvoices/language/english/setup.tra~

// Complete source-game packs

BEGIN @51000
DESIGNATED 1000
LABEL ALLVOICES-BG
GROUP @50000
REQUIRE_PREDICATE GAME_IS ~bgee bg2ee iwdee eet~ @59000
