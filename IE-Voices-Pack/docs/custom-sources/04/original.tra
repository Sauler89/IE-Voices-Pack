 @0 = ~Dagoth Ur Voice Pack~
 @1 = ~Through fire and war.~ [dagothi]
 @2 = ~How can you kill a God?~ [dagothj]
 @3 = ~What a fool you are.~ [dagothk]
 @4 = ~What a grand and intoxicating innocence!~ [dagoths]
 @5 = ~Is this how you honor the Sixth House and the tribe unmourned?~ [dagotht]
 @6 = ~I wait for you there, where we last met, countless ages ago.~ [dagothu]
 @7 = ~Omnipotent. Omniscient. Sovereign. Immutable.~ [dagothv]
 @8 = ~Together let us free the cursed false Gods.~ [dagothx]
 @9 = ~How could you be so naive?~ [dagothy]
@10 = ~Come, Nerevar, friend or traitor, come.~ [dagotha_]
@16 = ~Hah-hah-hah-hah-hah!~ [dagotha]
@17 = ~There is no escape!~ [dagoth8]
@18 = ~Come. Lay down your weapons. It is not too late for my mercy.~ [dagoth9]
@21 = ~This is taking too long...~ [dagothd] 
@24 = ~Welcome, Moon-and-Star, to this place where destiny is made.~ [dagotho]
@25 = ~Dagoth Ur welcomes you.~ [dagothf]
@26 = ~Persistent, arn't you?~ [dagothg]
@27 = ~I'm a God.~ [dagothh]
@28 = ~Shame on you, hah-hah-hah.~ [dagoth0]
@32 = ~Hah-hah-hah-hah. Oh, dear me.~ [dagothz] 
@33 = ~Come on!~ [dagoth1] 
@34 = ~Stupid...~ [dagothl] 
@37 = ~Together we shall speak for the Law and the Land!~ [dagothq] 
@38 = ~FOOL!~ [dagoth6] 
@39 = ~No Recall or Intervention can work in this place.~ [dagothp]
@40 = ~This is the end. The bitter, bitter end.~ [dagothm] 
@42 = ~You are a stubborn thing...~ [dagothn] 
@43 = ~Better luck on your next incarnation.~ [dagothw] 
@46 = ~I surrender! I surrender! Hah-hah-hah-hah-hah!~ [dagothe]
@48 = ~Damn this thing...~ [dagoth2] 
@49 = ~What are you doing?~ [dagoth3] 
@50 = ~How sweet it is to be a god!~ [dagothb]
@54 = ~Welcome, Moon-and-Star.~ [dagothr] 
@55 = ~I have need of it.~ [dagoth4] 
@64 = ~Come to me openly, and not by stealth.~ [dagoth5] 
@65 = ~This is getting tiresome...~ [dagothc] 
@67 = ~Forgive me but I am enjoying this.~ [dagoth7] 
@70 = ~Dagoth Ur~
