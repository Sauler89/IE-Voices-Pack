 @0 = ~Christopher Lee Soundset~
 @1 = ~Nothing will stand in our way!~ [CHRLEEi]
 @2 = ~Victory is at hand!~ [CHRLEEj]
 @3 = ~This way!~ [CHRLEEk]
 @4 = ~His gaze pierces cloud, shadow, earth and flesh.~ [CHRLEEs]
 @5 = ~You do not know pain, you do not know fear!~ [CHRLEEt]
 @6 = ~We have only to remove those who oppose us.~ [CHRLEEu]
 @7 = ~There would be no dawn for men.~ [CHRLEEv]
 @8 = ~Do you know how the orcs first came to being? They were elves once.~ [CHRLEEx]
 @9 = ~One ill turn deserves another. It is over.~ [CHRLEEy]
@16 = ~Stain the land with blood of our enemies!~ [CHRLEEa]
@17 = ~You have elected the way of pain!~ [CHRLEE8]
@18 = ~You are all going to die!~ [CHRLEE9]
@19 = ~Leave none alive!~ [CHRLEEg_]
@20 = ~So you have chosen... death!~ [CHRLEEh_]
@21 = ~Time? What time do you think we have?~ [CHRLEEd] 
@24 = ~What is the house of Rohan but a thatched barn where brigands drink in the reek and rats roll on the floor with the dogs?~ [CHRLEEo]
@25 = ~We have work to do.~ [CHRLEEf]
@26 = ~You are sure of this?~ [CHRLEEg]
@27 = ~The hour grows late.~ [CHRLEEh]
@28 = ~Whom do you serve?~ [CHRLEE0]
@29 = ~It would be wise, my friend.~ [CHRLEEk_]
@30 = ~The world is changing.~ [CHRLEEl_]
@32 = ~As you see my powers are far beyond yours!~ [CHRLEEz] 
@33 = ~Good! Twice the pride, double the fall!~ [CHRLEE1] 
@34 = ~~ [CHRLEEl] 
@37 = ~One ring to rule them all, one ring to find them, One ring to bring them all, and in the darkness bind them.~ [CHRLEEq] 
@38 = ~Surely you can do better!~ [CHRLEE6] 
@39 = ~Something fester in heart of Middle-Earth. Something that you have failed to see.~ [CHRLEEp] 
@40 = ~Save your pity and your mercy I have no use for it!~ [CHRLEEm] 
@42 = ~The old world will burn in the fires of industry. Forrest will fall. New order will rise.~ [CHRLEEn] 
@43 = ~I'm sure you did the best you could. We will discuss your failure later.~ [CHRLEEw] 
@46 = ~Brave, but foolish!~ [CHRLEEe] 
@48 = ~Does he seek to humble me with his new found piety!~ [CHRLEE2] 
@49 = ~Your love of the halfling's leaf has clearly slowed your mind.~ [CHRLEE3] 
@50 = ~New power is rising! It's victory is at hand!~ [CHRLEEb] 
@54 = ~We will drive the machine of war with the sword and the spear and the iron fist of the orc.~ [CHRLEEr] 
@55 = ~That is why you have come, is it not?~ [CHRLEE4] 
@56 = ~Time? What time do you think we have?~ [CHRLEEw_]
@57 = ~I want them armed and ready to march within two weeks!~ [CHRLEEx_]
@58 = ~The hour is later then you think.~ [CHRLEEy_]
@59 = ~Hunt them down! Do not stop until they are found!~ [CHRLEEz_]
@64 = ~Move on!~ [CHRLEE5] 
@65 = ~You've interfered with our affairs for the last time.~ [CHRLEEc] 
@67 = ~Why should we fear to use it?~ [CHRLEE7] 
@70 = ~CHRLEE~
