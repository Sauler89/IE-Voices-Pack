 @0 = ~Rondak~
 @1 = ~Done and done and done.~ [rondaki]
 @2 = ~There is glory in this... probably.~ [rondakj]
 @3 = ~The bard will tell tales of this.~ [rondakk]
 @4 = ~Valor calls!~ [rondaks]
 @5 = ~He he, I like it!~ [rondakt]
 @6 = ~Leave it to me.~ [rondaku]
 @7 = ~Ha ha, of course!~ [rondakv]
 @8 = ~I'm a lover, not a fighter. But in this case I'll make an exception.~ [rondakx]
 @9 = ~You may not know it at a glance, but I've got a dark side to me. I enjoy pineapple on pizza.~ [rondaky]
@10 = ~action sound, rare 3 ~ [rondaka_]
@11 = ~action sound, rare 4 ~ [rondakb_]
@12 = ~attack sound 1~ [rondakc_]
@13 = ~attack sound 2~ [rondakd_]
@14 = ~attack sound 3~ [rondake_]
@15 = ~attack sound 4~ [rondakf_]
@16 = ~You will fall, like so many others before you!~ [rondaka]
@17 = ~Tremble, ruffians!~ [rondak8]
@18 = ~The light shall reveal your duplicity, foe.~ [rondak9]
@19 = ~battle cry 4~ [rondakg_]
@20 = ~battle cry 5~ [rondakh_]
@21 = ~We'll do no good standing around. Get off of Facebook and let's go adventure!~ [rondakd] 
@22 = ~bored 2~ [rondaki_]
@23 = ~unhappy, breaking point~ [rondakj_]
@24 = ~Blood on the cobblestone, and secrets in the alleys. I have no love of the city.~ [rondako]
@25 = ~Greetings!~ [rondakf]
@26 = ~What is my task?~ [rondakg]
@27 = ~Yes, my friend.~ [rondakh]
@28 = ~Come at me. I await, you devils.~ [rondak0]
@29 = ~selection sound, common 5~ [rondakk_]
@30 = ~selection sound, common 6~ [rondakl_]
@31 = ~selection sound, common 7~ [rondakm_]
@32 = ~Falter!~ [rondakz] 
@33 = ~Huh eh... nobody saw that!~ [rondak1] 
@34 = ~*Grunts*~ [rondakl] 
@35 = ~takes damage 2~ [rondakn_]
@36 = ~takes damage 3~ [rondako_]
@37 = ~I've always loved the sunshine. The day cast light no treachery may hide from.~ [rondakq] 
@38 = ~My spell is ruined. I must try again.~ [rondak6] 
@39 = ~Evil may lurk around every corner, but so do we! Steel yourself, villains, we approach.~ [rondakp] 
@40 = ~Urgh! The gods will welcome me, fiend!~ [rondakm] 
@41 = ~death 2~ [rondakp_]
@42 = ~I love the smell of the trees and grass. Small reminders that there are yet places evil has not crept.~ [rondakn] 
@43 = ~No! My friend. I will avenge you!~ [rondakw] 
@44 = ~death of a party member 2~ [rondakq_]
@45 = ~happy~ [rondakr_]
@46 = ~I am... stabbed.~ [rondake] 
@47 = ~seriously wounded 2~ [rondaks_]
@48 = ~Hrrm! We must change our tactics, I'm having no effect.~ [rondak2] 
@49 = ~I would if I could, but I won't. Because I can't!~ [rondak3] 
@50 = ~An honour, truly. But there are no leaders amongst friends.~ [rondakb] 
@51 = ~becoming leader 2~ [rondakt_]
@52 = ~morale failure 1~ [rondaku_]
@53 = ~morale failure 2~ [rondakv_]
@54 = ~Dark intentions whisper, just out of earshot. But with every dusk, comes a dawn!~ [rondakr] 
@55 = ~Well... there we go! I suppose...~ [rondak4] 
