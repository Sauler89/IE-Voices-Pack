@62 = ~selection sound, rare 7 (used as nagged action response in BG2)~ [rondak2_]
@63 = ~selection sound, rare 8 (used as nagged action response in BG2)~ [rondak3_]
@64 = ~I slip away, ready to strike.~ [rondak5] 
@65 = ~Evil never slumbers, but... I do. We should rest.~ [rondakc] 
@66 = ~tired 2~ [rondak4_]
@67 = ~Watch where you step, villains.~ [rondak7] 
@68 = ~unhappy, annoyed~ [rondak5_]
