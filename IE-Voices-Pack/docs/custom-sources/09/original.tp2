BACKUP ~cd_gromn/backup~
SUPPORT ~Gromnir Il-Khan player voicepack: 10 curated slots; intentionally sparse~

LANGUAGE ~English~ ~english~ ~%MOD_FOLDER%/english/setup.tra~

BEGIN @0

REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @71

INCLUDE ~%MOD_FOLDER%/tph/cd_add_soundset.tph~

COPY ~%MOD_FOLDER%/sounds~ ~lang/en_us/sounds~
COPY ~%MOD_FOLDER%/wav~    ~override~

LAF cd_add_soundset
  INT_VAR
    cd_battlecry1      = RESOLVE_STR_REF(@1)
    cd_common1         = RESOLVE_STR_REF(@2)
    cd_common2         = RESOLVE_STR_REF(@3)
    cd_common3         = RESOLVE_STR_REF(@4)
    cd_action1         = RESOLVE_STR_REF(@5)
    cd_damage1         = RESOLVE_STR_REF(@6)
    cd_dying1          = RESOLVE_STR_REF(@7)
    cd_action_rare1    = RESOLVE_STR_REF(@8)
    cd_battlecry2      = RESOLVE_STR_REF(@9)
    cd_breaking_pt     = RESOLVE_STR_REF(@10)
    cd_select_name     = RESOLVE_STR_REF(@70)
  STR_VAR cd_name = "GROMVP"
END
