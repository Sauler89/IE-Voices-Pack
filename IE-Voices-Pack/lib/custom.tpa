// Re-add portraits after Infinity UI++ rebuilds its defaults on the start screen.
ACTION_IF FILE_EXISTS_IN_GAME ~UI.MENU~ BEGIN
    COPY_EXISTING ~UI.MENU~ ~override~
        PATCH_IF (INDEX_BUFFER (~function rgGetGameEnginePortraits~) >= 0) AND (INDEX_BUFFER (~-- IE-Voices-Pack custom portraits~) < 0) BEGIN
            REPLACE_TEXTUALLY ~^\([ %TAB%]*\)rgGetGameEnginePortraits()[ %TAB%]*$~
                ~\1rgGetGameEnginePortraits()
\1if type(ivpRegisterCustomPortraits) == 'function' then ivpRegisterCustomPortraits() end -- IE-Voices-Pack custom portraits~
        END
    BUT_ONLY_IF_IT_CHANGES
END
PRINT @54004
