// Only component #3000 asks these questions. Answers are recorded by WeiDU for reinstalls.
ACTION_IF FILE_EXISTS ~dlc/sod-dlc.zip~ OR FILE_EXISTS ~sod-dlc.zip~ BEGIN FAIL @59004 END
INCLUDE ~%MOD_FOLDER%/lib/custom-soundset.tph~

OUTER_SPRINT ivp_mode ~~
PRINT @54000
OUTER_WHILE !(~%ivp_mode%~ STRING_EQUAL_CASE ~1~ OR ~%ivp_mode%~ STRING_EQUAL_CASE ~2~) BEGIN
    ACTION_READLN ivp_mode
    ACTION_IF !(~%ivp_mode%~ STRING_EQUAL_CASE ~1~ OR ~%ivp_mode%~ STRING_EQUAL_CASE ~2~) BEGIN PRINT @54001 END
END
OUTER_SET ivp_selected_count = 0
COPY ~%MOD_FOLDER%/sources/custom/soundset-registry.lua~ ~override/M_ivcsnd.lua~
COPY ~%MOD_FOLDER%/sources/custom/portrait-registry.lua~ ~override/M_ivport.lua~

OUTER_SPRINT ivp_choice_01 ~y~
ACTION_IF ~%ivp_mode%~ STRING_EQUAL_CASE ~2~ BEGIN
    OUTER_SPRINT ivp_choice_01 ~~
    PRINT @54101
    OUTER_WHILE !(~%ivp_choice_01%~ STRING_EQUAL_CASE ~y~ OR ~%ivp_choice_01%~ STRING_EQUAL_CASE ~yes~ OR ~%ivp_choice_01%~ STRING_EQUAL_CASE ~1~ OR ~%ivp_choice_01%~ STRING_EQUAL_CASE ~n~ OR ~%ivp_choice_01%~ STRING_EQUAL_CASE ~no~ OR ~%ivp_choice_01%~ STRING_EQUAL_CASE ~0~) BEGIN
        ACTION_READLN ivp_choice_01
        ACTION_IF !(~%ivp_choice_01%~ STRING_EQUAL_CASE ~y~ OR ~%ivp_choice_01%~ STRING_EQUAL_CASE ~yes~ OR ~%ivp_choice_01%~ STRING_EQUAL_CASE ~1~ OR ~%ivp_choice_01%~ STRING_EQUAL_CASE ~n~ OR ~%ivp_choice_01%~ STRING_EQUAL_CASE ~no~ OR ~%ivp_choice_01%~ STRING_EQUAL_CASE ~0~) BEGIN PRINT @54002 END
    END
END
ACTION_IF (~%ivp_choice_01%~ STRING_EQUAL_CASE ~y~ OR ~%ivp_choice_01%~ STRING_EQUAL_CASE ~yes~ OR ~%ivp_choice_01%~ STRING_EQUAL_CASE ~1~) BEGIN
    INCLUDE ~%MOD_FOLDER%/sources/custom/01/install.tpa~
    OUTER_SET ivp_selected_count += 1
END

