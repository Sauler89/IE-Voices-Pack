@16 = ~This one needs to be kissed - with my blades.~ [ayganna] // battle cry 1 [a]
@17 = ~The waking world is done with you.~ [aygann8] // battle cry 2 [8]
@18 = ~The spririts of Rashemon shall soon gain another.~ [aygann9] // battle cry 3 [9]
@21 = ~If there is a spirit of boredom and idleness, then I would like to know who summoned it to hound us.~ [aygannd] // bored 1 [d] 
