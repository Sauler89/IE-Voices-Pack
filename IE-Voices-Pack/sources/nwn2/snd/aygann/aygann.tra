@46 = ~My life runs thin.~ [ayganne] // seriously wounded 1 [e] 
@47 = ~I shall soon walk in dreams no more.~ [ayganns_] // seriously wounded 2 [s_]
@48 = ~My attacks are as a dream to this thing.~ [aygann2] // target is immune [2] 
@49 = ~The sheer amount of garbage you are having me carry is impeding my movement.~ [aygann3] // inventory full [3] 
@50 = ~All who can hear - follow.~ [aygannb] // becoming leader 1 [b] 
