 @0 = ~AYGANN~ // Column Name
 @1 = ~As easy as dreaming.~ [ayganni] // action sound, common 1 [i]
 @2 = ~Done - and done well.~ [aygannj] // action sound, common 2 [j]
 @3 = ~That is an excellent idea you have dreamed up.~ [aygannk] // action sound, common 3 [k]
