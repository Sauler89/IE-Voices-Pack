 @0 = ~AYDOVE~ // Soundset Name
 @1 = ~I shall do so.~ [aydovei] // action sound, common 1 [i]
 @2 = ~In Akachi's name.~ [aydovej] // action sound, common 2 [j]
 @3 = ~I see nothing flawed in such an idea.~ [aydovek] // action sound, common 3 [k]
@12 = ~[grunt]~ [aydovec_] // attack sound 1 [c_]
@16 = ~For the Crusade!~ [aydovea] // battle cry 1 [a]
@17 = ~To the City of Judgment you go.~ [aydove8] // battle cry 2 [8]
@18 = ~The call of death sounds for you.~ [aydove9] // battle cry 3 [9]
@21 = ~The Crusade calls. Every moment we hesitate, its call grows fainter.~ [aydoved] // bored 1 [d] 
@25 = ~Yes?~ [aydovef] // selection sound, common 1 [f]
@26 = ~For the Crusade.~ [aydoveg] // selection sound, common 2 [g]
@27 = ~May Ilmater watch over you.~ [aydoveh] // selection sound, common 3 [h]
@32 = ~[grunt]~ [aydovez] // critical hit [z] 
@33 = ~[grunt]~ [aydove1] // critical miss [1] 
@34 = ~[grunt]~ [aydovel] // takes damage 1 [l] 
@35 = ~[grunt]~ [aydoven_] // takes damage 2 [n_]
@36 = ~[grunt]~ [aydoveo_] // takes damage 3 [o_]
@38 = ~Ilmater's blessings are of no use.~ [aydove6] // spell disrupted [6] 
@40 = ~[groan]~ [aydovem] // death 1 [m] 
@46 = ~My wounds are grave.~ [aydovee] // seriously wounded 1 [e] 
@47 = ~Shield me, and I shall shield you.~ [aydoves_] // seriously wounded 2 [s_]
@48 = ~My weapons are of no avail against this thing.~ [aydove2] // target is immune [2] 
@49 = ~I bear too much for my feet to heed me.~ [aydove3] // inventory full [3] 
@50 = ~To me, my allies. I shall lead.~ [aydoveb] // becoming leader 1 [b] 
@52 = ~We cannot hold. We must retreat before we are overrun.~ [aydoveu_] // morale failure 1 [u_]
@53 = ~Allies, to me!~ [aydovev_] // morale failure 2 [v_]
@56 = ~You, you're a... Oh, I don't know any profanity! How embarrassing.~ [aydovew_] // selection sound, rare 1 [w_]
@57 = ~Cross me, my allies, or my faith, and your spirit shall feel the power of all three.~ [aydovex_] // selection sound, rare 2 [x_]
@65 = ~Sleep calls, as does Ilmater's touch. I suggest we rest and recenter ourselves.~ [aydovec] // tired 1 [c] 
