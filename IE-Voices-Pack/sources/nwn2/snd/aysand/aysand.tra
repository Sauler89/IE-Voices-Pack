@56 = ~I suppose I could say something about a Luskan-bred dog, or a Hosttower thrall, but really, it's not polite to say.~ [aysandw_] // selection sound, rare 1 [w_]
@57 = ~I suggest you not try my patience any further than you have or I might accidentally fire a magic missile into your face.~ [aysandx_] // selection sound, rare 2 [x_]
