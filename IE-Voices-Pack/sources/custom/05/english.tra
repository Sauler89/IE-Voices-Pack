@70 = ~DotA 2: Invoker~
@1 = ~Yes!~ [IVC05i]
@2 = ~Of course.~ [IVC05j]
@3 = ~I proceed.~ [IVC05k]
@4 = ~Throughout the aeons I have been known by many names...but my true name of power...is Carl.~ [IVC05s]
@5 = ~Behold before you, the illustrious, the imperious, ingenious arch-mage... Carl.~ [IVC05t]
@6 = ~Oh, they'll rue the day they crossed me!~ [IVC05u]
@7 = ~Like a match already dim and damp, your mind snuffs out.~ [IVC05v]
@8 = ~An honor to fight me.~ [IVC05a]
@9 = ~Attack!~ [IVC058]
@10 = ~You dare fight me?~ [IVC059]
@11 = ~This bores me.~ [IVC05d]
@12 = ~Whatever that was, twas scarcely worth my notice.~ [IVC05o]
@13 = ~Behold!~ [IVC05f]
@14 = ~Invoker!~ [IVC05g]
@15 = ~Be mindful of your purpose.~ [IVC05h]
@16 = ~All can be known, and known by me.~ [IVC050]
@17 = ~*Maniacally laughter*~ [IVC05z]
@18 = ~Shitty wizard!~ [IVC051]
@19 = ~*Grunts*~ [IVC05l]
@20 = ~Whosoever stands against me, stands briefly.~ [IVC05q]
@21 = ~Traitorous sorcery.~ [IVC056]
@22 = ~You'd have done better to clothe yourself in knowledge, for all the good your scraps of armor did you.~ [IVC05p]
@23 = ~Darkness and ignorance take you all!~ [IVC05m]
@24 = ~I must have stepped on something.~ [IVC05n]
@25 = ~Fools die... as you well know.~ [IVC05w]
@26 = ~Can't you see I'm under attack?!~ [IVC05e]
@27 = ~Did I miscast?~ [IVC052]
@28 = ~What need have I for this?~ [IVC053]
@29 = ~It falls to me to inform you that this one is in the bag!~ [IVC05b]
@30 = ~Cause for my enemies to dwell on me exclusively!~ [IVC05r]
@31 = ~*Chuckles*~ [IVC054]
@32 = ~I slip from sight.~ [IVC055]
@33 = ~'Tis tedious.~ [IVC05c]
@34 = ~I'm betwixt myself.~ [IVC057]
