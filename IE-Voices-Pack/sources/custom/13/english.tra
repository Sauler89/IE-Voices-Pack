@70 = ~Rondak (lawful good)~
@1 = ~Done and done and done.~ [IVC13i]
@2 = ~There is glory in this... probably.~ [IVC13j]
@3 = ~The bard will tell tales of this.~ [IVC13k]
@4 = ~Valor calls!~ [IVC13s]
@5 = ~He he, I like it!~ [IVC13t]
@6 = ~Leave it to me.~ [IVC13u]
@7 = ~Ha ha, of course!~ [IVC13v]
@8 = ~You will fall, like so many others before you!~ [IVC13a]
@9 = ~Tremble, ruffians!~ [IVC138]
@10 = ~The light shall reveal your duplicity, foe.~ [IVC139]
@11 = ~We'll do no good standing around. Get off of Facebook and let's go adventure!~ [IVC13d]
@12 = ~Blood on the cobblestone, and secrets in the alleys. I have no love of the city.~ [IVC13o]
@13 = ~Greetings!~ [IVC13f]
@14 = ~What is my task?~ [IVC13g]
@15 = ~Yes, my friend.~ [IVC13h]
@16 = ~Come at me. I await, you devils.~ [IVC130]
@17 = ~Falter!~ [IVC13z]
@18 = ~Huh eh... nobody saw that!~ [IVC131]
@19 = ~*Grunts*~ [IVC13l]
@20 = ~I've always loved the sunshine. The day cast light no treachery may hide from.~ [IVC13q]
@21 = ~My spell is ruined. I must try again.~ [IVC136]
@22 = ~Evil may lurk around every corner, but so do we! Steel yourself, villains, we approach.~ [IVC13p]
@23 = ~Urgh! The gods will welcome me, fiend!~ [IVC13m]
@24 = ~I love the smell of the trees and grass. Small reminders that there are yet places evil has not crept.~ [IVC13n]
@25 = ~No! My friend. I will avenge you!~ [IVC13w]
@26 = ~I am... stabbed.~ [IVC13e]
@27 = ~Hrrm! We must change our tactics, I'm having no effect.~ [IVC132]
@28 = ~I would if I could, but I won't. Because I can't!~ [IVC133]
@29 = ~An honour, truly. But there are no leaders amongst friends.~ [IVC13b]
@30 = ~Dark intentions whisper, just out of earshot. But with every dusk, comes a dawn!~ [IVC13r]
@31 = ~Well... there we go! I suppose...~ [IVC134]
@32 = ~I slip away, ready to strike.~ [IVC135]
@33 = ~Evil never slumbers, but... I do. We should rest.~ [IVC13c]
@34 = ~Watch where you step, villains.~ [IVC137]
@35 = ~~ [IVC13x]
@36 = ~~ [IVC13y]
