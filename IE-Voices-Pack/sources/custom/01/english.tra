@70 = ~Archimonde~
@1 = ~Hardly worth the effort.~ [IVC01i]
@2 = ~Ha ha ha ha!~ [IVC01j]
@3 = ~Bold.~ [IVC01k]
@4 = ~Almost too easy.~ [IVC01s]
@5 = ~Witness the end.~ [IVC01t]
@6 = ~The time for reckoning has come.~ [IVC01x]
@7 = ~Doom has come to this world!~ [IVC01a]
@8 = ~Fools!~ [IVC018]
@9 = ~Damn you!~ [IVC019]
@10 = ~Weak.~ [IVC01g_]
@11 = ~You are mine.~ [IVC01h_]
@12 = ~The Legion has returned to consume this world!~ [IVC01j_]
@13 = ~Hahaha.~ [IVC01f]
@14 = ~Are there none left to stand against the Legion?~ [IVC01g]
@15 = ~At last.~ [IVC01h]
@16 = ~The final hour has come.~ [IVC010]
@17 = ~Kill!~ [IVC01z]
@18 = ~Hahahahaha.~ [IVC011]
@19 = ~Fool!~ [IVC01l]
@20 = ~[death cry]~ [IVC01m]
@21 = ~You have done well.~ [IVC01r_]
@22 = ~I wonder why Mannoroth even bothered with you.~ [IVC012]
@23 = ~I've had fun scouring your wretched nations.~ [IVC013]
@24 = ~Tremble, mortals, and despair!~ [IVC01b]
@25 = ~Fool!~ [IVC01w_]
@26 = ~We would have launched this invasion centuries ago...~ [IVC01x_]
@27 = ~Soon, I will order the invasion to begin.~ [IVC017]
@28 = ~Wretched little whelp.~ [IVC015_]
@29 = ~You may still prove useful to us.~ [IVC016_]
