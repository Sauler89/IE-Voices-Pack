@70 = ~DotA 2: Puck~
@1 = ~It's in the bag!~ [IVC06i]
@2 = ~I venture forth.~ [IVC06j]
@3 = ~Absolutely.~ [IVC06k]
@4 = ~With alacrity.~ [IVC06s]
@5 = ~Commendable notion.~ [IVC06t]
@6 = ~Very well.~ [IVC06u]
@7 = ~Interesting.~ [IVC06v]
@8 = ~After them!~ [IVC06a]
@9 = ~Stay and amuse me!~ [IVC068]
@10 = ~Destroy!~ [IVC069]
@11 = ~Let the world end now, it matters not to me.~ [IVC06d]
@12 = ~I find myself strangely drawn to this odd configuration of activity.~ [IVC06o]
@13 = ~Behold!~ [IVC06f]
@14 = ~Here I am!~ [IVC06g]
@15 = ~What is this, a game of some sort?~ [IVC06h]
@16 = ~I have time in abundance.~ [IVC060]
@17 = ~Ha ha!~ [IVC06z]
@18 = ~Uhrrn!~ [IVC061]
@19 = ~Huh!~ [IVC06l]
@20 = ~A dark interval, and now a bright one.~ [IVC06q]
@21 = ~Crummy wizard!~ [IVC066]
@22 = ~Ah, gambits and exploits await.~ [IVC06p]
@23 = ~A midsummer nightmare.~ [IVC06m]
@24 = ~What is this nature you speak of?~ [IVC06n]
@25 = ~Presumably a pity.~ [IVC06w]
@26 = ~I am under attack!~ [IVC06e]
@27 = ~A disturbing lapse!~ [IVC062]
@28 = ~You might wish to retract your last move.~ [IVC063]
@29 = ~I am unfamiliar with this feeling. Is it joy?~ [IVC06b]
@30 = ~Not yours!~ [IVC064]
@31 = ~Regrettably, I remove myself from sight.~ [IVC065]
@32 = ~I do enjoy an occasional blink.~ [IVC06c]
@33 = ~Patience, my prize.~ [IVC067]
