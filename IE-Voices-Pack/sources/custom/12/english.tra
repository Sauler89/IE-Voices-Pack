@70 = ~Palpatine~
@1 = ~So be it.~ [IVC12i]
@2 = ~Execute Order 66.~ [IVC12j]
@3 = ~Good.~ [IVC12k]
@4 = ~Dew it.~ [IVC12s]
@5 = ~It's treason, then.~ [IVC12t]
@6 = ~Patience, my friend.~ [IVC12u]
@7 = ~I can feel your anger.~ [IVC12v]
@8 = ~Aaaaaaaah!~ [IVC12a]
@9 = ~Die.~ [IVC128]
@10 = ~Now you will experience the full power of the Dark Side.~ [IVC129]
@11 = ~Use my knowledge, I beg you.~ [IVC12d]
@12 = ~Once more the Sith will rule the galaxy.~ [IVC12o]
@13 = ~Ah yes.~ [IVC12f]
@14 = ~Yeeees.~ [IVC12g]
@15 = ~In time you will call me... Master.~ [IVC12h]
@16 = ~Hahahahahahahahaha!~ [IVC120]
@17 = ~Unlimited pooooweeeerr!!~ [IVC12z]
@18 = ~No. No! No!~ [IVC121]
@19 = ~Your feeble skills have no match for the power of the Dark Side!~ [IVC12l]
@20 = ~The time has come.~ [IVC12q]
@21 = ~Oh no!~ [IVC126]
@22 = ~From here, you will witness the final destruction of the Alliance, and the end of your insignificant rebellion.~ [IVC12p]
@23 = ~Aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaah~ [IVC12m]
@24 = ~There is a great disturbance in the force. ~ [IVC12n]
@25 = ~Ironic. He can save others from death, but not himself.~ [IVC12w]
@26 = ~I'm too weak! Oh, don't kill me!~ [IVC12e]
@27 = ~It is of no concern.~ [IVC122]
@28 = ~You want this, don't you?~ [IVC123]
@29 = ~I am the Senate.~ [IVC12b]
@30 = ~The dark side of the force is a pathway to many abilities some consider to be unnatural.~ [IVC12r]
@31 = ~Young fool.~ [IVC124]
@32 = ~Can you hear me?~ [IVC125]
@33 = ~I can't hold on any longer.~ [IVC12c]
@34 = ~Goooooood.~ [IVC127]
