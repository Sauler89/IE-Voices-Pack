@70 = ~Dagoth Ur~
@1 = ~Through fire and war.~ [IVC04i]
@2 = ~How can you kill a God?~ [IVC04j]
@3 = ~What a fool you are.~ [IVC04k]
@4 = ~What a grand and intoxicating innocence!~ [IVC04s]
@5 = ~Is this how you honor the Sixth House and the tribe unmourned?~ [IVC04t]
@6 = ~I wait for you there, where we last met, countless ages ago.~ [IVC04u]
@7 = ~Omnipotent. Omniscient. Sovereign. Immutable.~ [IVC04v]
@8 = ~Together let us free the cursed false Gods.~ [IVC04x]
@9 = ~How could you be so naive?~ [IVC04y]
@10 = ~Come, Nerevar, friend or traitor, come.~ [IVC04a_]
@11 = ~Hah-hah-hah-hah-hah!~ [IVC04a]
@12 = ~There is no escape!~ [IVC048]
@13 = ~Come. Lay down your weapons. It is not too late for my mercy.~ [IVC049]
@14 = ~This is taking too long...~ [IVC04d]
@15 = ~Welcome, Moon-and-Star, to this place where destiny is made.~ [IVC04o]
@16 = ~Dagoth Ur welcomes you.~ [IVC04f]
@17 = ~Persistent, arn't you?~ [IVC04g]
@18 = ~I'm a God.~ [IVC04h]
@19 = ~Shame on you, hah-hah-hah.~ [IVC040]
@20 = ~Hah-hah-hah-hah. Oh, dear me.~ [IVC04z]
@21 = ~Come on!~ [IVC041]
@22 = ~Stupid...~ [IVC04l]
@23 = ~Together we shall speak for the Law and the Land!~ [IVC04q]
@24 = ~FOOL!~ [IVC046]
@25 = ~No Recall or Intervention can work in this place.~ [IVC04p]
@26 = ~This is the end. The bitter, bitter end.~ [IVC04m]
@27 = ~You are a stubborn thing...~ [IVC04n]
@28 = ~Better luck on your next incarnation.~ [IVC04w]
@29 = ~I surrender! I surrender! Hah-hah-hah-hah-hah!~ [IVC04e]
@30 = ~Damn this thing...~ [IVC042]
@31 = ~What are you doing?~ [IVC043]
@32 = ~How sweet it is to be a god!~ [IVC04b]
@33 = ~Welcome, Moon-and-Star.~ [IVC04r]
@34 = ~I have need of it.~ [IVC044]
@35 = ~Come to me openly, and not by stealth.~ [IVC045]
@36 = ~This is getting tiresome...~ [IVC04c]
@37 = ~Forgive me but I am enjoying this.~ [IVC047]
