@70 = ~Shang Tsung~
@1 = ~And now for taste of things to come!~ [IVC15i]
@2 = ~Deal's a deal.~ [IVC15j]
@3 = ~The Emperor will not tolerate failure.~ [IVC15k]
@4 = ~The rules are quite clear.~ [IVC15s]
@5 = ~Tomorrow morning the great kombat begins.~ [IVC15t]
@6 = ~You are all witnesses to one of the greatest turning points in the history of your planet.~ [IVC15u]
@7 = ~Mortal Kombat continues!~ [IVC15v]
@8 = ~Let Mortal Kombat begin!~ [IVC15a]
@9 = ~They are mine FOREVER!~ [IVC158]
@10 = ~YOUR SOUL IS MINE!~ [IVC159]
@11 = ~Liu Kang! You will be first!~ [IVC15g_]
@12 = ~Finish him quickly!~ [IVC15h_]
@13 = ~Shang Tsung, at your service.~ [IVC15f]
@14 = ~It's an honour to finally meet you.~ [IVC15g]
@15 = ~Welcome!~ [IVC15h]
@16 = ~You're here to compete in Mortal Kombat.~ [IVC150]
@17 = ~I've plans for my beautiful Sonya.~ [IVC15k_]
@18 = ~But it is my boat and if you'd like a tour I'd love to give it to you myself.~ [IVC15l_]
@19 = ~Kung Lao's ascendant is competing in the tournament.~ [IVC15m_]
@20 = ~FATALITY!~ [IVC15z]
@21 = ~Won't happen again, I promise.~ [IVC151]
@22 = ~Ah!~ [IVC15l]
@23 = ~NEVER!~ [IVC15m]
@24 = ~Your soul is MINE!~ [IVC15w]
@25 = ~It's not time for foolish pride!~ [IVC15e]
@26 = ~Save your pity for the weak!~ [IVC15s_]
@27 = ~I'm impressed.~ [IVC152]
@28 = ~It has begun!~ [IVC15w_]
@29 = ~From this moment on my island will be your battleground.~ [IVC15x_]
@30 = ~Of course.~ [IVC15y_]
@31 = ~Princess Kitana...~ [IVC15z_]
@32 = ~We had a deal, remember?~ [IVC150_]
@33 = ~We've never been so close to absolute victory.~ [IVC151_]
@34 = ~Treasure these moments as if they were your last.~ [IVC152_]
@35 = ~Princess Kitana is 10,000 years old and the rightful heir to the throne of Outworld.~ [IVC153_]
@36 = ~FLAWLESS VICTORY.~ [IVC155]
